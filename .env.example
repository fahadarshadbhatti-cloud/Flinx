# Lowen Configuration
# Copy this file to ~/.config/lowen/.env and fill in your values

# Required: Your Groq API key (get a free fast key at https://console.groq.com)
GROQ_API_KEY=gsk_xxxx

# Push-to-talk hotkey (evdev key names)
# Dual-shift combo (hold Left Shift + Right Shift together):
HOTKEY=KEY_LEFTSHIFT+KEY_RIGHTSHIFT
# Single key alternatives:
# HOTKEY=KEY_RIGHTALT
# HOTKEY=KEY_RIGHTCTRL

# Floating glassmorphic pill overlay (true/false)
SHOW_PILL=true

# Pill position on screen (currently top-center)
PILL_POSITION=top-center

# Microphone device index (0, 1, 2...) or 'default'
MIC_DEVICE=default

# Whisper language hint (e.g. en, ar, fr, de, es) — leave empty for auto-detect
LANGUAGE=en

# Transcription context prompt to improve recognition of technical terms
TRANSCRIPTION_PROMPT="Lowen, dictation, voice-to-text, Wayland, Linux."

# Optional AI Post-Processing: cleans filler words ('um', 'uh'), fixes punctuation & capitalization
# Uses Groq Llama 3.1 8B (~150ms extra latency)
LLM_CLEAN=false
LLM_MODEL=llama-3.1-8b-instant

# Play subtle acoustic click sounds on start/stop recording
SOUND_FEEDBACK=true

# Minimum recording duration in seconds (shorter presses are ignored)
MIN_RECORDING_DURATION=0.3
